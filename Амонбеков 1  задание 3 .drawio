        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    CUSTOMER {\n        int customer_id PK\n        string name\n        string phone\n    }\n\n    MODEL {\n        int model_id PK\n        string name\n    }\n\n    RESOURCE {\n        int resource_id PK\n        string name\n        string type\n        string unit\n        decimal current_tariff\n    }\n\n    SPEC_VERSION {\n        int spec_version_id PK\n        int model_id FK\n        int version_no\n        // Уникальность пары (model_id, version_no) — задаётся на уровне БД\n    }\n\n    SPEC_VERSION_LINE {\n        int spec_version_id FK\n        int resource_id FK\n        decimal norm_per_backpack\n        PK(spec_version_id, resource_id)\n    }\n\n    ORDER {\n        int order_id PK\n        date date\n        int customer_id FK\n    }\n\n    ORDER_LINE {\n        int order_id FK\n        int line_no\n        int model_id FK\n        int required_spec_version_id FK\n        int quantity\n        decimal sale_price\n        PK(order_id, line_no)\n        // Бизнес-правило: required_spec_version_id.model_id = model_id — проверяется через FK/CHECK\n    }\n\n    BATCH {\n        int batch_id PK\n        date release_date\n        int spec_version_id FK\n        int quantity\n    }\n\n    BATCH_ALLOCATION {\n        int batch_id FK\n        int order_id FK\n        int line_no FK\n        int allocated_quantity\n        PK(batch_id, order_id, line_no)\n    }\n\n    CUSTOMER ||--o{ ORDER : \&quot;1:N\&quot;\n    ORDER ||--o{ ORDER_LINE : \&quot;1:N\&quot;\n    MODEL ||--o{ SPEC_VERSION : \&quot;1:N\&quot;\n    SPEC_VERSION ||--o{ SPEC_VERSION_LINE : \&quot;1:N\&quot;\n    RESOURCE ||--o{ SPEC_VERSION_LINE : \&quot;1:N\&quot;\n    SPEC_VERSION ||--o{ BATCH : \&quot;1:N\&quot;\n    BATCH ||--o{ BATCH_ALLOCATION : \&quot;1:N\&quot;\n    ORDER_LINE ||--o{ BATCH_ALLOCATION : \&quot;1:N\&quot;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6FHIqQgw4SxMn5IcnDSG-1">
